<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Must match WinDevicesNet, which is net8.0-windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>WinDevices.TestConsole</AssemblyName>
    <RootNamespace>WinDevices.TestConsole</RootNamespace>
  </PropertyGroup>

  <!--
    Referenced as a project, not through a HintPath into
    C:\Program Files\WinDevices. Building this console no longer depends on
    the library having been installed machine-wide, and the native
    WinDevices.dll arrives in the output automatically because
    WinDevicesNet declares it with CopyToOutputDirectory.
  -->
  <ItemGroup>
    <ProjectReference Include="..\WinDevicesNet\WinDevicesNet.csproj" />
  </ItemGroup>

</Project>
